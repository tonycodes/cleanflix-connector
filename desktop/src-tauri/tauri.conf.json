{
  "$schema": "https://schema.tauri.app/config/2",
    "productName": "Cleanflix Connector",
  "version": "0.1.0",
  "identifier": "pro.cleanflix.connector",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cleanflix Connector",
        "width": 900,
        "height": 780,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {"../sidecar": "sidecar"},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
